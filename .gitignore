.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.env
.vscode/
.idea/
.DS_Store

# Kaggle files and generated datasets (never commit transaction-level data)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and run-specific outputs
artifacts/models/*
artifacts/metrics/*
artifacts/figures/*
!artifacts/models/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/figures/.gitkeep
*.pt
*.pth
*.npy
*.npz
*.csv.zip
